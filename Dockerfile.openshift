# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/nodejs-20:latest AS build
WORKDIR /opt/app-root/src

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Stage 2: runtime (UBI nginx) ───────────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/nginx-124:latest AS runtime

# Copy built assets explicitly into the UBI nginx document root
COPY --from=build /opt/app-root/src/dist/ /opt/app-root/src/

# SPA routing fallback so deep links / refreshes serve index.html
COPY openshift/default.conf "${NGINX_DEFAULT_CONF_PATH}"

EXPOSE 8080

# Use the image's built-in run script (handles nginx startup correctly)
CMD ["/usr/libexec/s2i/run"]