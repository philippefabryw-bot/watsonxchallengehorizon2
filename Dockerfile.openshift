# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Stage 2: runtime (OpenShift-compatible) ────────────────────────────────────
# OpenShift runs containers as a random non-root UID.
# We use the Red Hat UBI nginx image which already handles this correctly, OR
# we configure the official nginx:alpine image to run on port 8080 without root.
FROM registry.access.redhat.com/ubi9/nginx-124:latest AS runtime

# Copy a custom nginx config that listens on 8080 and writes to /tmp (no root needed)
COPY openshift/nginx.conf /etc/nginx/nginx.conf

# Copy built assets
COPY --from=build /app/dist /usr/share/nginx/html

# Allow the random UID assigned by OpenShift to own required directories
RUN chmod -R 777 /var/cache/nginx /var/run /var/log/nginx /usr/share/nginx/html

# OpenShift: do NOT expose port 80 — use 8080
EXPOSE 8080

USER 1001

CMD ["nginx", "-g", "daemon off;"]
