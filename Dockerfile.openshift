# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/nodejs-20:latest AS build
WORKDIR /opt/app-root/src

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Stage 2: runtime (OpenShift-compatible UBI nginx) ──────────────────────────
FROM registry.access.redhat.com/ubi9/nginx-124:latest AS runtime

# UBI nginx serves content from /opt/app-root/src and is pre-configured
# to listen on 8080 as a non-root (1001) user — no manual perms needed.

# Copy built assets into the UBI nginx web root
COPY --from=build /opt/app-root/src/dist .

# The UBI image's default entrypoint starts nginx correctly.
# Port 8080 is already the image default.
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]