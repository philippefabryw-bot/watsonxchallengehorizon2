# UBI Node.js 20 — same registry that worked for the frontend (no Docker Hub auth)
FROM registry.access.redhat.com/ubi9/nodejs-20:latest

# Switch to root briefly to fix ownership, then drop back to 1001
USER root

WORKDIR /opt/app-root/src

# Install production dependencies first (better layer caching)
COPY package.json package-lock.json* ./
# Ensure the non-root user (1001) that UBI runs as can write the lock file
RUN chown -R 1001:0 /opt/app-root/src && chmod -R g=u /opt/app-root/src

USER 1001

RUN npm install --omit=dev

# Copy the server
COPY server.js ./

EXPOSE 8080

CMD ["node", "server.js"]
